<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network for weather API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Lets the climate pop-over open while another app (e.g. CarPlay) is in front -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Broadcast permission for MCU head unit event service -->
    <uses-permission android:name="com.szchoiceway.permission.broadcast" />
    <!-- Headlight (and later speed/RPM) state from the head unit's car info service -->
    <uses-permission android:name="com.tw.carinfoservice.permission.USE_AIDL" />

    <!-- GPS for telemetry and weather location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required for LocationManager.sendExtraCommand (A-GPS reset) — normal protection, auto-granted -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />

    <!-- Compass / sensors -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Media session control (requires notification access grant by user) -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <!-- Wallpaper from gallery -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Query all packages required on API 30+ for getInstalledApplications -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Required on API 30+ so PackageManager returns ALL launcher apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- TW head unit A/C service (ClimateWidget binds com.tw.ac.AirService) -->
        <package android:name="com.tw.ac" />
        <!-- TW car info service (HeadlightSource binds com.tw.carinfoservice) -->
        <package android:name="com.tw.carinfoservice" />
    </queries>

    <application
        android:label="Open Launcher"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:exported="true">

        <!-- Single launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustNothing">

            <!-- HOME launcher intent filters -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification listener service for MediaSession / Now Playing -->
        <service
            android:name=".service.MediaListenerService"
            android:exported="true"
            android:label="Open Launcher Media"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Climate pop-over shown above other apps when a physical HVAC control is
             pressed. Own task + no history so dismissing returns to the app underneath. -->
        <activity
            android:name=".climate.ClimateOverlayActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.openlauncher.app.climate"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

    </application>

</manifest>
